WEB_PORT=8080

MAX_SAMPLES=10
RECONNECT_MS=3000
SSH_READY_TIMEOUT_MS=15000

# Modo manual: deje REMOTE_COMMAND vacio y envie JSON Lines a:
# http://localhost:8080/api/samples
REMOTE_COMMAND=

# Modo automatico opcional: complete estos valores solo si quiere que
# el contenedor se conecte por SSH y ejecute el lector remoto.
# SSH_HOST=raspberrypi.local
# SSH_PORT=22
# SSH_USER=pi
# SSH_PRIVATE_KEY=/ssh/id_ed25519
# SSH_PASSPHRASE=
# SSH_PASSWORD=
# REMOTE_COMMAND=/home/pi/tp5/gpio_jsonl_reader --device /dev/tp5_gpio --interval-ms 500
